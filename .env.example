# Public site origin used for metadata/OG tags, robots and sitemap (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://epicstream.example.com

# Upstream API that the proxied endpoints read from (default: https://streamed.pk)
# STREAMED_API=https://streamed.pk

# Revalidation (seconds) applied to proxied upstream responses (default: 30)
# STREAMED_REVALIDATE=30

# Google Apps Script web app URL (see scripts/feedback.gs for setup)
NEXT_PUBLIC_FEEDBACK_WEBAPP_URL=